{
  "name": "market-forge",
  "version": "0.1.0",
  "private": true,
  "description": "A Strapi application",
  "scripts": {
    "build": "strapi build",
    "deploy": "strapi deploy",
    "develop": "strapi develop",
    "develop:api": "node --max-old-space-size=2048 node_modules/.bin/strapi develop --no-watch-admin",
    "develop:admin": "npx vite",
    "develop:admin:debug": "npx vite -c ./src/admin/vite.config.ts -l info -d",
    "develop:ssh": "ts-node dev.ts",
    "start": "strapi start",
    "strapi": "strapi",
    "docker:build": "docker build -f Dockerfile.dev -t marketforge-strapi-dev .",
    "docker:create": "docker create --name marketforge-strapi-dev -p 1337:1337 -p 5173:5173 marketforge-strapi-dev",
    "docker:start": "docker start marketforge-strapi-dev",
    "docker:stop": "docker stop marketforge-strapi-dev",
    "docker:rm": "docker rm marketforge-strapi-dev",
    "docker:rebuild": "yarn docker:stop && yarn docker:rm && yarn docker:build && yarn docker:create && yarn docker:start"
  },
  "dependencies": {
    "@_sh/strapi-plugin-ckeditor": "^5.0.1",
    "@strapi/icons": "2.0.0-rc.18",
    "@strapi/logger": "^5.11.2",
    "@strapi/plugin-documentation": "^5.12.7",
    "@strapi/plugin-graphql": "^5.0.0",
    "@strapi/plugin-seo": "^2.0.8",
    "@strapi/plugin-users-permissions": "5.12.7",
    "@strapi/strapi": "5.12.7",
    "lodash": "^4.17.19",
    "mysql2": "3.13.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "strapi-plugin-navigation": "^3.0.11",
    "strapi-provider-upload-azure-storage": "^3.4.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "sharp": "^0.34.1",
    "ts-node": "^10.9.2",
    "tunnel-ssh": "^5.2.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "packageManager": "yarn@4.9.1"
}
